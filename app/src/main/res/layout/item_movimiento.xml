<!--  Una tarjeta por movimiento (Clase 15): superficie distinta del fondo, 8 dp por fuera,
     esquinas asimétricas, descripción grande y monto/fecha pequeños.  -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/Widget.Material3.CardView.Filled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/marca_padding_small" app:cardBackgroundColor="?attr/colorSurfaceVariant" app:shapeAppearance="@style/ShapeAppearance.Marca.Tarjeta">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="@dimen/marca_padding_medium">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvDescripcion" style="@style/Marca.DisplayMedium" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurfaceVariant"/>
            <TextView android:id="@+id/tvMontoItem" style="@style/Marca.LabelSmall" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
            <TextView android:id="@+id/tvFechaItem" style="@style/Marca.BodyLarge" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurfaceVariant"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnEliminarMov" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:text="Eliminar"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>